{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/validate-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" validate-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__create_workflow_from_code$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/create-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" create-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__update_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/update-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" update-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__get_node_types$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/get-node.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" get-node",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__execute_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/execute-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" execute-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__test_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/test-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" test-workflow",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__create_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/agent-build.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" agent-build",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__mutate_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/agent-build.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" agent-build",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/validate-workflow.sh\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT/hooks/codex_hooks.py\" post-validate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
